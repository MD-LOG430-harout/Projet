{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cantelcox.local/contracts/events/CommandePassee/v1.json",
  "title": "CommandePassee v1",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "aggregateId", "aggregateType", "sagaId", "traceId", "correlationId", "causationId", "payload"],
  "properties": {
    "eventId": {"type": "string", "format": "uuid"},
    "eventType": {"const": "CommandePassee"},
    "eventVersion": {"const": 1},
    "occurredAt": {"type": "string", "format": "date-time"},
    "aggregateId": {"type": "string", "minLength": 1},
    "aggregateType": {"const": "Commande"},
    "sagaId": {"type": "string", "format": "uuid"},
    "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "correlationId": {"type": "string", "minLength": 1},
    "causationId": {"type": "null"},
    "payload": {
      "type": "object",
      "required": ["idCommande", "idClient", "idOffre", "montant", "devise"],
      "properties": {
        "idCommande": {"type": "string", "minLength": 1},
        "idClient": {"type": "string", "minLength": 1},
        "idOffre": {"type": "string", "minLength": 1},
        "montant": {"type": "number", "minimum": 0},
        "devise": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "numberMode": {"enum": ["NEW", "PORT_IN"]},
        "msisdnDemande": {"type": "string", "minLength": 1},
        "currentOperator": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
