# Local environment and secrets
.env
.env.*
!.env.example

# Python caches and test artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
pytest-cache-files-*/
.coverage
coverage.xml
htmlcov/

# Generated evidence artifacts, except the soutenance measurements which must
# stay reviewable alongside the report. Git does not descend into an excluded
# directory, so each level has to be re-opened explicitly.
docs/evidence/*
!docs/evidence/phase2/
docs/evidence/phase2/*
!docs/evidence/phase2/perf/

# Local deployment/runtime state
.deploy/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
*.tmp
*.bak
