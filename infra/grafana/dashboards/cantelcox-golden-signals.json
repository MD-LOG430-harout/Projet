{
  "title": "CanTelcoX Golden Signals",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Traffic RPS",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(cantelcox_http_requests_total[1m])) by (service)", "legendFormat": "{{service}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "sum(rate(cantelcox_http_requests_total{status=~\"4..|5..\"}[1m])) by (service,status)", "legendFormat": "{{service}} {{status}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency P95",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum(rate(cantelcox_http_request_duration_seconds_bucket[5m])) by (le, service))", "legendFormat": "{{service}}"}
      ]
    }
  ]
}

