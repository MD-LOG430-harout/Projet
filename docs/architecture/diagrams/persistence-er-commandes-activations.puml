@startuml
title commandes_activations - Logical ER

hide circle
skinparam linetype ortho

entity activations {
  * activation_id : CHAR(36) <<PK>>
  --
  idempotency_key : VARCHAR(160) <<UQ>>
  request_hash : CHAR(64)
  customer_id : CHAR(36) <<logical ref>>
  offer_id : VARCHAR(80) <<logical ref>>
  line_id : CHAR(36) <<logical ref>>
  status : VARCHAR(40)
  response_body : JSON
  http_status : INT
  failure_reason : VARCHAR(255)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity orders {
  * order_id : CHAR(36) <<PK>>
  --
  customer_id : CHAR(36) <<logical ref>>
  offer_id : VARCHAR(80) <<logical ref>>
  order_type : VARCHAR(60)
  status : VARCHAR(40)
  orchestration_status : VARCHAR(60)
  confirmation_status : VARCHAR(60)
  total_amount : DECIMAL(10,2)
  currency : CHAR(3)
  idempotency_key : VARCHAR(160) <<UQ>>
  request_hash : CHAR(64)
  response_body : JSON
  http_status : INT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

activations .. orders : same bounded context

note right of activations
  Constraints:
  - uq_activations_idempotency_key(idempotency_key)
  - idx_activations_customer(customer_id)
  - idx_activations_offer(offer_id)
  - idx_activations_line(line_id)
  - idx_activations_status(status)
end note

note right of orders
  Constraints:
  - uq_orders_idempotency_key(idempotency_key)
  - idx_orders_customer(customer_id)
  - idx_orders_offer(offer_id)
  - idx_orders_customer_status(customer_id, status)
  - idx_orders_status(status)
end note
@enduml
