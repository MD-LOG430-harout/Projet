@startuml
title usage_facturation - Logical ER

hide circle
skinparam linetype ortho

entity invoices {
  * invoice_id : CHAR(36) <<PK>>
  --
  customer_id : CHAR(36) <<logical ref>>
  billing_period : VARCHAR(20)
  amount_due : DECIMAL(10,2)
  currency : CHAR(3)
  status : VARCHAR(20)
  due_date : DATE
  created_at : DATETIME
  paid_at : DATETIME
}

entity payments {
  * payment_id : CHAR(36) <<PK>>
  --
  invoice_id : CHAR(36) <<logical ref>>
  customer_id : CHAR(36) <<logical ref>>
  idempotency_key : VARCHAR(160) <<UQ>>
  request_hash : CHAR(64)
  amount : DECIMAL(10,2)
  currency : CHAR(3)
  payment_method : VARCHAR(40)
  status : VARCHAR(20)
  response_body : JSON
  http_status : INT
  failure_reason : VARCHAR(255)
  created_at : TIMESTAMP
}

invoices ||..o{ payments : invoice_id logical ref

note right of invoices
  Indexes:
  - idx_invoices_customer(customer_id)
  - idx_invoices_customer_status(customer_id, status)
  - idx_invoices_status(status)
end note

note right of payments
  Exactly-once safeguards:
  - uq_payments_idempotency_key(idempotency_key)
  - uq_successful_payment_per_invoice(invoice_id, status)

  Indexes:
  - idx_payments_invoice(invoice_id)
  - idx_payments_customer(customer_id)
end note
@enduml
