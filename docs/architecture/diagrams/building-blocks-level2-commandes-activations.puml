@startuml
title svc-commandes-activations - Increment 1

top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 12

actor "Client REST" as Client
queue "Kafka\n7 topics entrants" as KafkaIn

package "Adapters entrants" #EAF2FF {
  rectangle "REST\nPOST /v1/orders -> 202\nGET /v1/orders/{id}/status" as Rest
  rectangle "OrderEventConsumer\nvalidation schema\ncommit offset apres transaction" as Consumer
}

package "Application et domaine" #E8F5E9 {
  rectangle "CreateOrder\nvalidations client + offre\nIdempotency-Key" as Create
  rectangle "GetOrderStatus" as Status
  rectangle "OrderSagaHandler\nprocessed_events\ngardes terminales" as Handler
  rectangle "Order + SagaState\nEN_COURS / CONFIRMEE / ANNULEE" as Domain
  rectangle "SagaTimeoutScanner\ndetection seulement" as Scanner
}

package "Adapters sortants" #F8FAFC {
  rectangle "CustomerClient" as Customer
  rectangle "OfferClient" as Offer
  rectangle "MysqlActivationRepository" as Repo
  rectangle "Outbox relay\npublication apres ACK" as Relay
}

database "MySQL commandes_activations\norders + saga_state\noutbox_events + processed_events" as DB
queue "Kafka\nCommandePassee\nCommandeConfirmee\nCommandeAnnulee" as KafkaOut

Client --> Rest
Rest --> Create : commande
Rest --> Status : lecture
Create --> Customer
Create --> Offer
Create --> Domain
Status --> Repo

KafkaIn --> Consumer
Consumer --> Handler
Handler --> Domain
Handler --> Repo
Scanner --> Repo

Create --> Repo
Repo --> DB
DB --> Relay
Relay --> KafkaOut : key = aggregateId

note right of Scanner
Aucune orchestration de compensation.
Aucun evenement timeout ajoute
aux 11 contrats canoniques.
end note

@enduml
