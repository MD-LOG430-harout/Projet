  "item": [
    {
      "name": "UC-01 - Clients & Identite",
      "item": [
        {
          "name": "Register customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const setVar = (key, value) => { pm.collectionVariables.set(key, value); if (pm.environment && pm.environment.name) { pm.environment.set(key, value); } };",
                  "const nonce = `${Date.now()}-${Math.random().toString(16).slice(2, 10)}`;",
                  "const msisdnSuffix = String(Math.floor(100000000 + Math.random() * 900000000));",
                  "setVar('runNonce', nonce);",
                  "setVar('traceId', `postman-phase1-${nonce}`);",
                  "setVar('email', `postman-${nonce}@example.test`);",
                  "setVar('identityDocumentNumber', `D-${nonce}`);",
                  "setVar('idempotencyKey', `postman-activation-${nonce}`);",
                  "setVar('portInIdempotencyKey', `postman-portin-${nonce}`);",
                  "setVar('orderIdempotencyKey', `postman-order-${nonce}`);",
                  "setVar('paymentIdempotencyKey', `postman-payment-${nonce}`);",
                  "setVar('portInMsisdn', `1438${msisdnSuffix}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const setVar = (key, value) => { pm.collectionVariables.set(key, value); if (pm.environment && pm.environment.name) { pm.environment.set(key, value); } };",
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "setVar('customerId', json.customerId);",
                  "pm.test('customer active and verified', function () {",
                  "  pm.expect(json.status).to.eql('ACTIVE');",
                  "  pm.expect(json.identityStatus).to.eql('VERIFIED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "TraceId",
                "value": "{{traceId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"Postman Demo\",\n  \"legalName\": \"Postman Demo\",\n  \"customerType\": \"individual\",\n  \"address\": {\n    \"line1\": \"123 Rue Test\",\n    \"city\": \"Montreal\",\n    \"province\": \"QC\",\n    \"postalCode\": \"H1A1A1\"\n  },\n  \"identityDocument\": {\n    \"type\": \"driver_license\",\n    \"number\": \"{{identityDocumentNumber}}\",\n    \"issuingProvince\": \"QC\",\n    \"expiryDate\": \"2030-12-31\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/customers/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "customers",
                "register"
              ]
            }
          }
        }
      ]
    },
