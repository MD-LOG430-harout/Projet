        {
          "name": "DELETE Hub subscription",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{hubBaseUrl}}/portability/hub/{{hubSubscriptionIdBss1}}"
          },
          "response": []
        }
      ]
